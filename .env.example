# Copy to .env and fill in from https://api-console.zoho.com/
# See docs/oauth-setup.md for the three-minute walkthrough.
#
# Only the Phase 0 spike scripts read this file. The CLI itself stores
# credentials in the OS keychain (or an encrypted file on platforms without
# one) — never in a dotfile.
#
#   chmod 600 .env

ZMAIL_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXX
ZMAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# com | eu | in | com.cn | com.au | jp
ZMAIL_LOCATION=com
